DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsappbot
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsappbot_test

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=120000
LLM_TEMPERATURE=0.2
MAX_TOOL_CALLS_PER_MESSAGE=5

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-haiku-5-5
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-5-5

# Required only when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TIMEOUT_MS=120000
